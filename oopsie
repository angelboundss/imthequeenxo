local function setActiveNav(name)
    currentPage = name
    for n, data in pairs(navButtons) do
        if n == name then
            tween(data.btn, {BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(30, 20, 34)})
            tween(data.label, {TextColor3 = C.White})
            if data.accent then data.accent.Visible = true end
        else
            tween(data.btn, {BackgroundTransparency = 1})
            tween(data.label, {TextColor3 = C.Mute})
            if data.accent then data.accent.Visible = false end
        end
    end
    for pn, p in pairs(pages) do p.Visible = (pn == name) end
end

