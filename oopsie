-- CamLock logic
local lastLockedPlayer = nil
local lastCamLockDir = nil
local currentCamLockTargetPart = nil

local function getLockPart(character)
    return getTargetPart(character) or character:FindFirstChild("Head")
end

local function getCamLockTargetByDistance()
    local bestPlayer, bestPart = nil, nil
    local bestDist = math.huge
    local root = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
    local originPos = root and root.Position or (cam and cam.CFrame.Position or Vector3.new())
    for _, p in pairs(plrs:GetPlayers()) do
        if p ~= me and not isWhitelisted(p) then
            local character = p.Character
            local humanoid = character and character:FindFirstChild("Humanoid")
            if character and humanoid and humanoid.Health > 0 then
                local part = getLockPart(character)
                if part and part:IsA("BasePart") then
                    local dist = (part.Position - originPos).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestPlayer = p
                        bestPart = part
                    end
                end
            end
        end
    end
    return bestPlayer, bestPart
end

local function refreshCamLockTarget()
    if lastLockedPlayer then
        local character = lastLockedPlayer.Character
        local humanoid = character and character:FindFirstChild("Humanoid")
        if character and humanoid and humanoid.Health > 0 then
            local part = getLockPart(character)
            if part and part:IsA("BasePart") then
                currentCamLockTargetPart = part
                return lastLockedPlayer, part
            end
        end
    end
    if currentCamLockTargetPart and currentCamLockTargetPart.Parent then
        return lastLockedPlayer, currentCamLockTargetPart
    end
    local targetPlayer, targetPart = getCamLockTargetByDistance()
    lastLockedPlayer = targetPlayer
    currentCamLockTargetPart = targetPart
    return targetPlayer, targetPart
end

local function updateCamLockState(enabled)
    _G.CamLock_Enabled = enabled
    if enabled then
        lastLockedPlayer = nil
        currentCamLockTargetPart = nil
        local targetPlayer, targetPart = getCamLockTargetByDistance()
        lastLockedPlayer = targetPlayer
        currentCamLockTargetPart = targetPart
    end
end

local function updateCamLockCamera()
    if not _G.CamLock_Enabled then
        lastLockedPlayer = nil
        currentCamLockTargetPart = nil
        lastCamLockDir = cam and cam.CFrame and cam.CFrame.LookVector or lastCamLockDir
        return
    end
    local mouseDelta = UIS:GetMouseDelta()
    if mouseDelta and mouseDelta.Magnitude > 0.001 then
        lastCamLockDir = cam.CFrame.LookVector
        return
    end
    local targetPlayer, targetPart = refreshCamLockTarget()
    if targetPlayer and targetPart and targetPart.Parent then
        local character = targetPlayer.Character
        local humanoid = character and character:FindFirstChild("Humanoid")
        if humanoid and humanoid.Health > 0 then
            local targetDir = (targetPart.Position - cam.CFrame.Position)
            if targetDir.Magnitude > 0 then
                targetDir = targetDir.Unit
                local smoothness = math.clamp(_G.CamLock_Smoothness or 0.15, 0.05, 1)
                local t = (smoothness - 0.05) / 0.95
                local alpha = 0.01 + 0.99 * (t * t * t)
                if not lastCamLockDir then lastCamLockDir = cam.CFrame.LookVector end
                local blended = (lastCamLockDir * (1 - alpha) + targetDir * alpha)
                if blended.Magnitude > 0 then
                    lastCamLockDir = blended.Unit
                    cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + lastCamLockDir)
                end
            end
        end
    end
end
RunService.RenderStepped:Connect(updateCamLockCamera)

