local function isWhitelisted(p)
    if not p then return false end
    for _, w in ipairs(_G.Whitelist) do if w == p then return true end end
    return false
end

local function showWhitelistNotification(action, player)
    if not player then return end
    local name = player.DisplayName or player.Name or "player"
    local text = action == "added" and (name .. " added to whitelist") or (name .. " removed from whitelist")
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Whitelist",
            Text = text,
            Duration = 2
        })
    end)
end

local function toggleWhitelist(p)
    if not p then return end
    for i, w in ipairs(_G.Whitelist) do
        if w == p then
            table.remove(_G.Whitelist, i)
            showWhitelistNotification("removed", p)
            return
        end
    end
    table.insert(_G.Whitelist, p)
    showWhitelistNotification("added", p)
end

local function teleportToPlayer(targetPlr)
    if not targetPlr or not targetPlr.Character then return end
    local targetHRP = targetPlr.Character:FindFirstChild("HumanoidRootPart")
    local myChar = me.Character
    if not targetHRP or not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
end

