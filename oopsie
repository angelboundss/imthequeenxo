    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 6)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = listFrame

    local empty = Instance.new("TextLabel")
    empty.Size = UDim2.new(1, -16, 0, 40)
    empty.Position = UDim2.new(0, 8, 0, 8)
    empty.BackgroundTransparency = 1
    empty.Text = "No other players in the server."
    empty.TextColor3 = Color3.fromRGB(140, 130, 170)
    empty.Font = Enum.Font.Gotham
    empty.TextSize = 13
    empty.TextXAlignment = Enum.TextXAlignment.Left
    empty.Parent = listFrame

    local function refreshWhitelistList()
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        empty.Visible = true
        local players = {}
        for _, p in ipairs(plrs:GetPlayers()) do
            if p ~= me then table.insert(players, p) end
        end
        table.sort(players, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
        if #players > 0 then empty.Visible = false end
        for i, p in ipairs(players) do
            local item = Instance.new("TextButton")
            item.Size = UDim2.new(1, -12, 0, 48)
            item.BackgroundColor3 = isWhitelisted(p) and Color3.fromRGB(60, 45, 90) or Color3.fromRGB(38, 34, 55)
            item.Text = ""
            item.AutoButtonColor = false
            item.Parent = listFrame
            item.LayoutOrder = i
            Instance.new("UICorner", item).CornerRadius = UDim.new(0, 8)

            local dn = Instance.new("TextLabel")
            dn.Size = UDim2.new(1, -20, 0, 20)
            dn.Position = UDim2.new(0, 12, 0, 8)
            dn.BackgroundTransparency = 1
            dn.Text = p.DisplayName
            dn.TextColor3 = Color3.fromRGB(220, 210, 255)
            dn.Font = Enum.Font.GothamBold
            dn.TextSize = 13
            dn.TextXAlignment = Enum.TextXAlignment.Left
            dn.Parent = item

            local un = Instance.new("TextLabel")
            un.Size = UDim2.new(1, -20, 0, 16)
            un.Position = UDim2.new(0, 12, 0, 26)
            un.BackgroundTransparency = 1
            un.Text = "@" .. p.Name
            un.TextColor3 = Color3.fromRGB(150, 140, 180)
            un.Font = Enum.Font.Gotham
            un.TextSize = 11
            un.TextXAlignment = Enum.TextXAlignment.Left
            un.Parent = item

            item.MouseButton1Click:Connect(function()
                toggleWhitelist(p)
                refreshWhitelistList()
            end)
        end
    end
    _G.refreshWhitelistList = refreshWhitelistList
    refreshWhitelistList()
end

