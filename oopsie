local function createESP(player)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Thickness = 1.5
    box.Filled = false
    local name = Drawing.new("Text")
    name.Visible = false
    name.Size = 16
    name.Center = true
    name.Outline = true
    name.Font = Drawing.Fonts.UI
    local healthBarBg = Drawing.new("Square")
    healthBarBg.Visible = false
    healthBarBg.Filled = true
    healthBarBg.Thickness = 0
    healthBarBg.Color = Color3.fromRGB(20, 20, 20)
    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Filled = true
    healthBar.Thickness = 0
    healthBar.Color = Color3.fromRGB(80, 220, 80)

    local conn
    conn = RunService.RenderStepped:Connect(function()
        local currentCam = workspace.CurrentCamera or cam
        if isWhitelisted(player) or not currentCam then
            box.Visible = false
            name.Visible = false
            healthBarBg.Visible = false
            healthBar.Visible = false
            return
        end
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local rootPart = player.Character.HumanoidRootPart
            local head = player.Character:FindFirstChild("Head") or rootPart
            local rootPos, rootOnScreen = currentCam:WorldToViewportPoint(rootPart.Position)
            if rootOnScreen then
                local headPos = currentCam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legPos = currentCam:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                local leftPos = currentCam:WorldToViewportPoint(rootPart.Position - rootPart.CFrame.RightVector * (rootPart.Size.X * 0.8))
                local rightPos = currentCam:WorldToViewportPoint(rootPart.Position + rootPart.CFrame.RightVector * (rootPart.Size.X * 0.8))
                local boxTop = headPos.Y - 8
                local boxBottom = legPos.Y + 4
                local boxHeight = math.max(boxBottom - boxTop, 40)
                local boxWidth = math.max(math.abs(rightPos.X - leftPos.X) * 0.65, boxHeight * 0.35, 20)

                if _G.ESP_Boxes then
                    box.Size = Vector2.new(boxWidth, boxHeight)
                    box.Position = Vector2.new(rootPos.X - boxWidth / 2, boxTop)
                    box.Color = _G.ESP_Color
                    box.Visible = true
                else
                    box.Visible = false
                end
                if _G.ESP_Names then
                    name.Text = player.DisplayName or player.Name or "Player"
                    name.Color = _G.ESP_Color
                    name.Position = Vector2.new(rootPos.X, boxTop - 18)
                    name.Visible = true
                else
                    name.Visible = false
                end
                if _G.ESP_Health then
                    local healthPct = math.clamp(player.Character.Humanoid.Health / math.max(1, player.Character.Humanoid.MaxHealth), 0, 1)
                    local barWidth = 4
                    local barHeight = math.clamp(boxHeight * 0.7, 24, 140)
                    local barX = rootPos.X + boxWidth / 2 + 8
                    local barY = rootPos.Y - barHeight / 2
                    healthBarBg.Size = Vector2.new(barWidth, barHeight)
                    healthBarBg.Position = Vector2.new(barX, barY)
                    healthBarBg.Visible = true
                    healthBar.Size = Vector2.new(barWidth, barHeight * healthPct)
                    healthBar.Position = Vector2.new(barX, barY + barHeight * (1 - healthPct))
                    healthBar.Color = Color3.fromHSV(math.clamp(healthPct, 0, 1) * 0.33, 1, 1)
                    healthBar.Visible = true
                else
                    healthBarBg.Visible = false
                    healthBar.Visible = false
                end
            else
                box.Visible = false
                name.Visible = false
                healthBarBg.Visible = false
                healthBar.Visible = false
            end
        else
            box.Visible = false
            name.Visible = false
            healthBarBg.Visible = false
            healthBar.Visible = false
            if not player or not player.Parent then
                box:Remove()
                name:Remove()
                healthBarBg:Remove()
                healthBar:Remove()
                conn:Disconnect()
            end
        end
    end)
end
