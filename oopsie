UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == TriggerBot.TriggerKey then
        TriggerBot.Active = not TriggerBot.Active
    end
    if input.KeyCode == _G.CamLock_Key and _G.CamLock_Enabled then
        camLockActive = not camLockActive
        if not camLockActive then currentCamLockTarget = nil; lastCamLockDir = nil end
    end
    if input.KeyCode == _G.Speed_Key and _G.Speed_ToggleEnabled then
        _G.Speed_Enabled = not _G.Speed_Enabled
    end
    if input.KeyCode == _G.JumpPower_Key and _G.JumpPower_ToggleEnabled then
        _G.JumpPower_Enabled = not _G.JumpPower_Enabled
    end
    if input.KeyCode == _G.Teleport_Key and selectedTeleportPlayer then
        if not teleportLoopActive then
            teleportLoopActive = true
            teleportToPlayer(selectedTeleportPlayer)
            task.spawn(function()
                while teleportLoopActive do
                    if selectedTeleportPlayer then teleportToPlayer(selectedTeleportPlayer) end
                    task.wait(0.15)
                    if not UserInputService:IsKeyDown(_G.Teleport_Key) then
                        teleportLoopActive = false
                        break
                    end
                end
            end)
        end
    end
    if input.KeyCode == _G.HideUi_Key and _G.HideUi_Enabled then
        if main.Visible then
            main.Visible = false
            if Config.Blur then tween(blur, {Size = 0}, TFast) end
        else
            main.Visible = true
            if Config.Blur then blur.Size = 0; tween(blur, {Size = 6}, TMed) end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == _G.Teleport_Key then
        teleportLoopActive = false
    end
end)

-- Toggle UI
local open = false
local function toggleUI()
    open = not open
    if open then
        main.Visible = true
        if Config.Blur then blur.Size = 0; tween(blur, {Size = 6}, TMed) end
    else
        if Config.Blur then tween(blur, {Size = 0}, TFast) end
        main.Visible = false
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then toggleUI() end
end)

task.delay(2.2, function()
    setActiveNav("Home")
    toggleUI()
    notify("Welcome", "Angelbounds is ready ♡")
end)

print("[Angelbounds] Full premium UI + all features loaded")
