-- ESP
local hasDrawing = pcall(function() return Drawing and Drawing.new end)
local function createESP(plr)
    if not hasDrawing then return end
    local ok, box = pcall(function()
        local b = Drawing.new("Square"); b.Visible=false; b.Thickness=1.3; b.Filled=false; return b
    end)
    if not ok or not box then return end
    local nok, name = pcall(function()
        local t = Drawing.new("Text"); t.Visible=false; t.Size=13; t.Center=true; t.Outline=true; return t
    end)
    if not nok then name = nil end
    local healthBarBg, healthBar
    pcall(function()
        healthBarBg = Drawing.new("Square"); healthBarBg.Visible=false; healthBarBg.Filled=true; healthBarBg.Thickness=0
        healthBar = Drawing.new("Square"); healthBar.Visible=false; healthBar.Filled=true; healthBar.Thickness=0
    end)
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not plr or not plr.Parent then
            pcall(function() box:Remove() end)
            if name then pcall(function() name:Remove() end) end
            if healthBarBg then pcall(function() healthBarBg:Remove() end) end
            if healthBar then pcall(function() healthBar:Remove() end) end
            conn:Disconnect()
            return
        end
        if isWhitelisted(plr) then
            box.Visible = false
            if name then name.Visible = false end
            if healthBarBg then healthBarBg.Visible = false end
            if healthBar then healthBar.Visible = false end
            return
        end
        local char = plr.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local root = char.HumanoidRootPart
            local head = char:FindFirstChild("Head") or root
            local rp, on = cam:WorldToViewportPoint(root.Position)
            if on then
                local hp = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.55, 0))
                local lp = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                local h = math.max(math.abs(hp.Y - lp.Y), 40)
                local w = math.max(h * 0.45, 20)
                if _G.ESP_Boxes then
                    box.Size = Vector2.new(w, h)
                    box.Position = Vector2.new(rp.X - w/2, rp.Y - h/2)
                    box.Color = _G.ESP_Color
                    box.Visible = true
                else box.Visible = false end
                if name and _G.ESP_Names then
                    name.Text = plr.DisplayName
                    name.Position = Vector2.new(rp.X, hp.Y - 16)
                    name.Color = _G.ESP_Color
                    name.Visible = true
                elseif name then name.Visible = false end
                if healthBarBg and healthBar and _G.ESP_Health then
                    local pct = math.clamp(char.Humanoid.Health / math.max(1, char.Humanoid.MaxHealth), 0, 1)
                    local barH = math.clamp(h * 0.7, 24, 120)
                    healthBarBg.Size = Vector2.new(4, barH)
                    healthBarBg.Position = Vector2.new(rp.X + w/2 + 6, rp.Y - barH/2)
                    healthBarBg.Color = Color3.fromRGB(20, 20, 20)
                    healthBarBg.Visible = true
                    healthBar.Size = Vector2.new(4, barH * pct)
                    healthBar.Position = Vector2.new(rp.X + w/2 + 6, rp.Y - barH/2 + barH * (1 - pct))
                    healthBar.Color = Color3.fromHSV(pct * 0.33, 1, 1)
                    healthBar.Visible = true
                else
                    if healthBarBg then healthBarBg.Visible = false end
                    if healthBar then healthBar.Visible = false end
                end
            else
                box.Visible = false
                if name then name.Visible = false end
                if healthBarBg then healthBarBg.Visible = false end
                if healthBar then healthBar.Visible = false end
            end
        else
            box.Visible = false
            if name then name.Visible = false end
            if healthBarBg then healthBarBg.Visible = false end
            if healthBar then healthBar.Visible = false end
        end
    end)
end
