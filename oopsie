-- CamLock
local function getCamLockTarget()
    local best, bestD = nil, math.huge
    local origin = (me.Character and me.Character:FindFirstChild("HumanoidRootPart") and me.Character.HumanoidRootPart.Position) or cam.CFrame.Position
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= me and not isWhitelisted(p) and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local part = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local d = (part.Position - origin).Magnitude
                if d < bestD then bestD = d; best = part end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not (_G.CamLock_Enabled and camLockActive) then return end
    if not currentCamLockTarget or not currentCamLockTarget.Parent then
        currentCamLockTarget = getCamLockTarget()
    end
    if currentCamLockTarget and currentCamLockTarget.Parent then
        local dir = (currentCamLockTarget.Position - cam.CFrame.Position)
        if dir.Magnitude > 0 then
            dir = dir.Unit
            local a = math.clamp(_G.CamLock_Smoothness, 0.01, 1)
            if not lastCamLockDir then lastCamLockDir = cam.CFrame.LookVector end
            local blend = lastCamLockDir * (1 - a) + dir * a
            if blend.Magnitude > 0 then
                lastCamLockDir = blend.Unit
                cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + lastCamLockDir)
            end
        end
    end
end)

